# Supabase project settings — Project Settings > API in the Supabase dashboard.
# The anon key is safe to expose to the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for admin/seeding scripts run from a trusted server context —
# never import this in client code or commit a real value here.
# SUPABASE_SERVICE_ROLE_KEY=
